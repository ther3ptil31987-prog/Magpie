      <SHA256>AFD9B7AD335D78663126B315C50C2A8820C474CE6DEBEDA414DD633ACEAD949D</SHA256>
    </NvidiaVfxRuntimeFile>
    <NvidiaVfxRuntimeFile Include="$(VFXRuntimeDir)\cudart64_12.dll">
