      <SHA256>55B32C685D2A42350B55D8DFD1D58F715FE002A35F44E9CCEE370260D9B698ED</SHA256>
    </NvidiaVfxRuntimeFile>
    <NvidiaVfxRuntimeFile Include="$(VFXSdkDir)\features\nvvfxvideosuperres\bin\nvVFXVideoSuperRes.dll">
      <SdkRelativePath>features/nvvfxvideosuperres/bin/nvVFXVideoSuperRes.dll</SdkRelativePath><Role>VSR</Role>
      <SHA256>5BA6AC2A933C3CCE56DD202A1780023E405EA57BDC32B85BC7787D44B08C0B3D</SHA256>
    </NvidiaVfxRuntimeFile>
    <NvidiaVfxRuntimeFile Include="$(VFXSdkDir)\features\nvvfxvideosuperres\bin\nvngx_vsr.dll">
