      <SHA256>AEDDF0387D7F440C2BD4634D2E496065DB17D590B222CE4DDCA26015E96CC7CD</SHA256>
    </NvidiaVfxRuntimeFile>
    <NvidiaVfxExcludedCoreName Include="cublas64_12.dll;cublasLt64_12.dll;nvinfer_10.dll;nvinfer_plugin_10.dll;nvonnxparser_10.dll;nvrtc64_120_0.dll;nvrtc-builtins64_128.dll;nppc64_12.dll;nppial64_12.dll;nppicc64_12.dll;nppidei64_12.dll;nppif64_12.dll;nppig64_12.dll;nppim64_12.dll;nppist64_12.dll;nppitc64_12.dll;libcrypto-3-x64.dll" />
