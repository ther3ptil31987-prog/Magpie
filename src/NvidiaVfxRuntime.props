<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!-- Canonical allowlist for the four-feature 1.3.0.0 Windows x64 suite.
       Full is a private-validation layout; Minimal still contains all features. -->
  <PropertyGroup>
    <NvidiaVfxRuntimePackageVersion>1.3.0.0</NvidiaVfxRuntimePackageVersion>
  </PropertyGroup>
  <ItemGroup Condition="$(EnableNvidiaVfx) And '$(Platform)' == 'x64'">
    <NvidiaVfxRuntimeFile Include="$(VFXRuntimeDir)\NVVideoEffects.dll">
      <SdkRelativePath>bin/NVVideoEffects.dll</SdkRelativePath><Role>Core</Role>
      <SHA256>2FAB7E1C13EF28C2AB8F14D9DFACB5062B7B74374035AF7466C58458922EC1BE</SHA256>
    </NvidiaVfxRuntimeFile>
    <NvidiaVfxRuntimeFile Include="$(VFXRuntimeDir)\NVCVImage.dll">
