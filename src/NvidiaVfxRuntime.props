      <SHA256>3ED97A8F5DD0AFD5CEB9E98B3FA9A868A134F74103B3747E9765595606C3F509</SHA256>
    </NvidiaVfxRuntimeFile>
    <NvidiaVfxRuntimeFile Include="$(VFXSdkDir)\features\nvvfxvideoframegeneration\bin\nvVFXVideoFrameGeneration.dll">
      <SdkRelativePath>features/nvvfxvideoframegeneration/bin/nvVFXVideoFrameGeneration.dll</SdkRelativePath><Role>VFG</Role>
      <SHA256>F803E891E75B1A1D9D4A42C0FFFC208FA48953E6E135CE9493E935BC0044FC97</SHA256>
    </NvidiaVfxRuntimeFile>
    <NvidiaVfxRuntimeFile Include="$(VFXSdkDir)\features\nvvfxtruehdr\bin\nvVFXTrueHDR.dll">
      <SdkRelativePath>features/nvvfxtruehdr/bin/nvVFXTrueHDR.dll</SdkRelativePath><Role>TrueHDR</Role>
      <SHA256>B762C5DAEC5F3CD85EC78A34CE1985212FCE86828A01316106BAE62DC1D6097D</SHA256>
    </NvidiaVfxRuntimeFile>
    <NvidiaVfxRuntimeFile Include="$(VFXSdkDir)\features\nvvfxtruehdr\bin\nvngx_truehdr.dll">
