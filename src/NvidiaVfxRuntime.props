    <NvidiaVfxLicenseFile Include="ThirdPartyLicenses.txt"><SHA256>207B323C79C8D73A1570378597B77DD6CE15D05D0391D9C4D1AEF628490BBE70</SHA256></NvidiaVfxLicenseFile>
