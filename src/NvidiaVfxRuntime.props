      <SHA256>F5FB39DAB8D8C5E7CF7E6E9B12EC1D27E4A6505A6BCE28DD34AA1E9A26B4D9E3</SHA256>
    </NvidiaVfxRuntimeFile>
    <NvidiaVfxRuntimeFile Include="$(VFXRuntimeDir)\nvngxruntime.dll">
      <SdkRelativePath>bin/nvngxruntime.dll</SdkRelativePath><Role>Core</Role>
      <SHA256>531878E1C60CE10171CCC4F56BF87060CD5D34ED93A00B198A5FFFE04EA42FB5</SHA256>
    </NvidiaVfxRuntimeFile>
    <NvidiaVfxRuntimeFile Include="$(VFXSdkDir)\features\nvvfxupscale\bin\nvVFXUpscale.dll">
