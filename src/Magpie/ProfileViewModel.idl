namespace Magpie {
	runtimeclass ProfileViewModel : Windows.UI.Xaml.Data.INotifyPropertyChanged {
		Windows.UI.Xaml.Controls.IconElement Icon { get; };
		String Name { get; };
		Boolean IsNotDefaultProfile { get; };

		void Launch();

		Boolean IsProgramExist { get; };
		Boolean IsNotPackaged { get; };

		void OpenProgramLocation();
		void ChangeExeForLaunching();

		String RenameText;
		Boolean IsRenameConfirmButtonEnabled { get; };
		void Rename();
		void RenameFlyout_Opening();
		void RenameTextBox_KeyDown(Object sender, Windows.UI.Xaml.Input.KeyRoutedEventArgs args);
		Int32 RenameTextBoxSelectionStart { get; };
		void RenameButton_Click();
		Boolean CanDrag { get; };

		void Delete();
		
		IVector<IInspectable> ScalingModes { get; };
		Int32 ScalingMode;

		IVector<IInspectable> CaptureMethods { get; };
		Int32 CaptureMethod;
		Boolean IsCaptureMethodDesktopDuplication { get; };

		Int32 AutoScale;
		Boolean IsParameterFocusSwitchingEnabled;
		Boolean Is3DGameMode;
		Boolean IsHdrCompatibilityEnabled;

		Boolean HasMultipleMonitors { get; };
		IVector<IInspectable> MonitorOptions { get; };
		Int32 MonitorSelection;

		Int32 InitialWindowedScaleFactor;
		Double CustomInitialWindowedScaleFactor;

		IVector<IInspectable> GraphicsCards { get; };
		IInspectable GraphicsCard;
		Boolean IsGraphicsCardSelectionEnabled { get; };
		Boolean IsNoGraphicsCard { get; };
		Boolean ShowGraphicsCardUnavailableWarning { get; };

		Int32 FrameRefreshModeIndex;
		Boolean IsSimpleFrameRefresh { get; };
		Boolean IsAdvancedFrameRefresh { get; };
		Int32 ContentFrameRateModeIndex;
		Boolean SimpleRtssSync;
		Int32 RtssModeIndex;
		Int32 RtssTargetScopeIndex;
		Boolean ShowRtssOptions { get; };
		Boolean ShowContentPacing { get; };
		Boolean ShowRtssDownload { get; };
		Boolean CanRetryRtss { get; };
		void RetryRtss();
		Int32 RtssScopeIndex;
		Int32 RtssRateModeIndex;
		Double RtssCustomRate;
		Double RtssSyncedRate { get; };
		Int32 RtssExitPolicyIndex;
		Boolean IsRtssManaged { get; };
		Boolean ShowRtssCustomRate { get; };
		Boolean ShowRtssSyncedRate { get; };
		Boolean IsRtssSyncAvailable { get; };
		Boolean ShowRtssGlobalNotice { get; };
		String RtssStatusTitle { get; };
		String RtssStatusDescription { get; };
		String RtssStatusGlyph { get; };
		Boolean IsRtssBusy { get; };
		Boolean ShowRtssManagement { get; };
		String RtssProgramStatus { get; };
		String RtssSelfStatus { get; };
		String RtssManagementResult { get; };
		Boolean ShowRtssManagementResult { get; };
		Boolean CanRecheckRtss { get; };
		String RtssStatusText { get; };
		IVector<String> RtssStatusSegments { get; };
		String RtssSyncText { get; };
		Boolean CanLaunchRtss { get; };
		Boolean CanInitializeMagpie { get; };
		Boolean ShowRtssInitialize { get; };
		String RtssInitializeText { get; };
		void InitializeMagpieRtss();
		Boolean CanLaunchAfterburner { get; };
		String RtssLaunchText { get; };
		String AfterburnerLaunchText { get; };
		void RefreshRtss();
		void LaunchRtss();
		void LaunchAfterburner();
		Double ContentFrameRate;
		Int32 FrameSyncModeIndex;
		Boolean IsContentPacingEnabled { get; };
		Boolean ShowContentFrameRate { get; };
		Int32 CursorRefreshModeIndex;
		Int32 CursorSupplementModeIndex;
		Double CursorSupplementRate;
		Boolean ShowCursorSupplement { get; };
		Boolean ShowCursorSupplementRate { get; };
		Int32 IdleRedrawModeIndex;
		Double IdleRedrawRate;
		Boolean ShowIdleRedrawRate { get; };
		Int32 DuplicateFrameDetectionMode;
		Boolean ShowFrameRefreshNotice { get; };
		String FrameRefreshNotice { get; };
		void ResetFrameRefresh();
		Boolean IsVRREnabled;

		Boolean IsCaptureTitleBar;
		Boolean CanCaptureTitleBar { get; };

		Boolean IsCroppingEnabled;
		Double CroppingLeft;
		Double CroppingTop;
		Double CroppingRight;
		Double CroppingBottom;

		Boolean IsAdjustCursorSpeed;
		Int32 CursorScaling;
		Double CustomCursorScaling;
		Int32 CursorInterpolationMode;
		Boolean IsAutoHideCursorEnabled;
