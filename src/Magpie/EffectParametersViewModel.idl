namespace Magpie {
	runtimeclass ScalingModeParameter : Windows.UI.Xaml.Data.INotifyPropertyChanged {
		Boolean IsBoolean { get; };
		Boolean IsChoice { get; };
		Boolean IsFloat { get; };
		Boolean IsVisible { get; };
		Boolean IsEnabled { get; };
		Boolean BooleanValue;
		Int32 ChoiceValue;
		Int32 ChoiceIndex;
		IObservableVector<String> Choices { get; };
		Double Value;
		String Label { get; };
		String Tooltip { get; };
		Boolean HasDescriptionLine { get; };
		Boolean HasNoDescriptionLine { get; };
		String PrimaryLabel { get; };
		String DescriptionLabel { get; };
		String ValueText { get; };
		Boolean IsPreciseInput { get; };
		Boolean IsLegacyNumeric { get; };
		String EditableValue;
		String InputError { get; };
		Boolean HasInputError { get; };
		Double SliderValue;
		Double SliderMinimum { get; };
		Double SliderMaximum { get; };
		Double SliderStep { get; };
		Double Minimum { get; };
		Double Maximum { get; };
		Double Step { get; };
	}

	runtimeclass EffectParameterGroupViewModel : Windows.UI.Xaml.Data.INotifyPropertyChanged {
		String Label { get; };
		Boolean HasLabel { get; };
		Boolean IsVisible { get; };
		Double ColumnWidth { get; };
		Boolean ShowLeadingSeparator { get; };
		IVector<IInspectable> Params { get; };
	}

	runtimeclass EffectParametersViewModel : Windows.UI.Xaml.Data.INotifyPropertyChanged {
		UInt32 ScalingModeIdx;
		UInt32 EffectIdx;

		Double ContentWidth { get; };
		Double ContentMaxHeight { get; };
		IVector<IInspectable> Groups { get; };
	}
}
