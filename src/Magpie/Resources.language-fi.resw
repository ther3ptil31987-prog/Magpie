    <value>Open recovery guide</value>
  </data>
  <data name="DlssNr_OpenDirectory" xml:space="preserve">
    <value>Open program directory</value>
  </data>
  <data name="DlssNr_OpenFailed" xml:space="preserve">
    <value>Could not open the location. Use the path below to open it manually.</value>
  </data>
  <data name="ErrorDetails_EffectsChanged" xml:space="preserve">
    <value>The recorded effect group or its effect order has changed, or its name is ambiguous. The list is open; locate the group using the name in the diagnostics. No other group was selected.</value>
  </data>
