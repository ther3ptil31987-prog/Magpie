<Page xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:local="using:Magpie"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
	x:Class="Magpie.ProfilePage"
	mc:Ignorable="d">
	<Page.Resources>
		<!-- Page-local dimensions; other settings pages retain their existing layout. -->
		<x:Double x:Key="SettingsCardWrapThreshold">600</x:Double>
		<x:Double x:Key="SettingsCardWrapNoIconThreshold">0</x:Double>
		<x:Double x:Key="ProfileControlColumnWidth">280</x:Double>
		<x:Double x:Key="ProfileNumberColumnWidth">116</x:Double>
		<GridLength x:Key="ProfileUnitColumnWidth">28</GridLength>
		<x:Double x:Key="ProfileActionWidth">136</x:Double>
		<x:Double x:Key="ProfileControlGap">8</x:Double>
		<Style x:Key="ProfileCardStyle" TargetType="local:SettingsCard" BasedOn="{StaticResource DefaultSettingsCardStyle}">
			<Setter Property="Padding" Value="16,16,48,16"/>
			<Setter Property="IsWrapEnabled" Value="True"/>
		</Style>
		<Style x:Key="ProfileItemStyle" TargetType="local:SettingsCard" BasedOn="{StaticResource DefaultSettingsExpanderItemStyle}">
			<Setter Property="Padding" Value="58,8,48,8"/>
			<Setter Property="IsWrapEnabled" Value="True"/>
		</Style>
		<Style x:Key="ProfileExpanderStyle" TargetType="local:SettingsExpander" BasedOn="{StaticResource DefaultSettingsExpanderStyle}">
			<!-- Native chevron occupies 32 + 8 DIP outside the header card. -->
			<Setter Property="Padding" Value="16,16,8,16"/>
			<Setter Property="IsWrapEnabled" Value="True"/>
		</Style>
		<Style x:Key="ProfileComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource DefaultComboBoxStyle}">
			<Setter Property="MinWidth" Value="0"/>
			<Setter Property="HorizontalAlignment" Value="Stretch"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
		</Style>
		<Style x:Key="ProfileNumberBoxStyle" TargetType="muxc:NumberBox">
			<Setter Property="MinWidth" Value="0"/>
			<Setter Property="HorizontalAlignment" Value="Stretch"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
			<Setter Property="SpinButtonPlacementMode" Value="Hidden"/>
			<Setter Property="Padding" Value="8,4,0,4"/>
		</Style>
		<Style x:Key="ProfileActionStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
			<Setter Property="Width" Value="{StaticResource ProfileActionWidth}"/>
			<Setter Property="MinWidth" Value="0"/>
			<Setter Property="HorizontalAlignment" Value="Right"/>
			<Setter Property="ContentTemplate">
				<Setter.Value>
					<DataTemplate>
						<TextBlock Text="{Binding}" TextWrapping="Wrap" TextAlignment="Center"/>
					</DataTemplate>
				</Setter.Value>
			</Setter>
		</Style>
		<DataTemplate x:Key="RtssOptionTextTemplate">
			<TextBlock Text="{Binding}" TextWrapping="Wrap"/>
		</DataTemplate>
		<Style x:Key="FrameRefreshModeItemStyle" TargetType="ListBoxItem" BasedOn="{StaticResource DefaultListBoxItemStyle}">
			<Setter Property="MinWidth" Value="0"/>
			<Setter Property="MinHeight" Value="28"/>
			<Setter Property="Padding" Value="12,4"/>
			<Setter Property="UseSystemFocusVisuals" Value="True"/>
			<Setter Property="FocusVisualMargin" Value="-2"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="ListBoxItem">
						<Grid x:Name="Root" Control.IsTemplateFocusTarget="True" Background="Transparent" CornerRadius="{ThemeResource ControlCornerRadius}">
							<VisualStateManager.VisualStateGroups>
								<VisualStateGroup x:Name="CommonStates">
									<VisualState x:Name="Normal"/>
									<VisualState x:Name="PointerOver">
										<VisualState.Setters>
											<Setter Target="Root.Background" Value="{ThemeResource ControlFillColorSecondaryBrush}"/>
										</VisualState.Setters>
									</VisualState>
									<VisualState x:Name="Pressed">
										<VisualState.Setters>
											<Setter Target="Root.Background" Value="{ThemeResource ControlFillColorTertiaryBrush}"/>
										</VisualState.Setters>
									</VisualState>
									<VisualState x:Name="Selected">
										<VisualState.Setters>
											<Setter Target="SelectionSurface.Visibility" Value="Visible"/>
											<Setter Target="SelectionIndicator.Visibility" Value="Visible"/>
										</VisualState.Setters>
									</VisualState>
									<VisualState x:Name="SelectedUnfocused">
										<VisualState.Setters>
											<Setter Target="SelectionSurface.Visibility" Value="Visible"/>
											<Setter Target="SelectionIndicator.Visibility" Value="Visible"/>
										</VisualState.Setters>
									</VisualState>
									<VisualState x:Name="SelectedPointerOver">
										<VisualState.Setters>
											<Setter Target="SelectionSurface.Visibility" Value="Visible"/>
											<Setter Target="SelectionSurface.Background" Value="{ThemeResource ControlFillColorSecondaryBrush}"/>
											<Setter Target="SelectionIndicator.Visibility" Value="Visible"/>
										</VisualState.Setters>
									</VisualState>
									<VisualState x:Name="SelectedPressed">
										<VisualState.Setters>
											<Setter Target="SelectionSurface.Visibility" Value="Visible"/>
											<Setter Target="SelectionSurface.Background" Value="{ThemeResource ControlFillColorTertiaryBrush}"/>
											<Setter Target="SelectionIndicator.Visibility" Value="Visible"/>
										</VisualState.Setters>
									</VisualState>
									<VisualState x:Name="Disabled">
										<VisualState.Setters>
											<Setter Target="Root.Opacity" Value="0.5"/>
										</VisualState.Setters>
									</VisualState>
								</VisualStateGroup>
							</VisualStateManager.VisualStateGroups>
							<Border x:Name="SelectionSurface"
								Visibility="Collapsed"
								Background="{ThemeResource ControlFillColorDefaultBrush}"
								BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
								BorderThickness="1"
								CornerRadius="{ThemeResource ControlCornerRadius}"/>
							<ContentPresenter Margin="{TemplateBinding Padding}"
								Content="{TemplateBinding Content}"
								ContentTemplate="{TemplateBinding ContentTemplate}"
								Foreground="{TemplateBinding Foreground}"
								HorizontalAlignment="Center"
								VerticalAlignment="Center"/>
							<Border x:Name="SelectionIndicator"
								Visibility="Collapsed"
								Width="16"
								Height="2"
								Margin="0,0,0,1"
								VerticalAlignment="Bottom"
								HorizontalAlignment="Center"
								CornerRadius="1"
								Background="{ThemeResource SystemControlHighlightAccentBrush}"/>
						</Grid>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
	</Page.Resources>
	<local:PageFrame Title="{x:Bind ViewModel.Name, Mode=OneWay}" Icon="{x:Bind ViewModel.Icon, Mode=OneWay}">
		<local:SimpleStackPanel Padding="0,4,0,0"
			HorizontalAlignment="Stretch"
			ChildrenTransitions="{StaticResource SettingsCardsAnimations}"
			Spacing="{StaticResource SettingsGroupSpacing}">
			<local:SettingsGroup x:Uid="Profile_General">
				<local:SettingsCard Style="{StaticResource ProfileCardStyle}"
					Loaded="ProfileCard_Loaded"
					SizeChanged="ProfileCard_SizeChanged"
					x:Uid="Profile_General_ScalingMode"
					IsWrapEnabled="True">
					<local:SettingsCard.HeaderIcon>
						<PathIcon Data="{StaticResource SpecialEffectSizeIconData}"/>
					</local:SettingsCard.HeaderIcon>
					<ComboBox Style="{StaticResource ProfileComboBoxStyle}"
						DropDownOpened="ComboBox_DropDownOpened"
						ItemsSource="{x:Bind ViewModel.ScalingModes, Mode=OneTime}"
						SelectedIndex="{x:Bind ViewModel.ScalingMode, Mode=TwoWay}"/>
				</local:SettingsCard>
				<local:SettingsCard Style="{StaticResource ProfileCardStyle}"
					Loaded="ProfileCard_Loaded"
					SizeChanged="ProfileCard_SizeChanged"
					x:Uid="Profile_General_CaptureMethod"
					IsWrapEnabled="True">
					<local:SettingsCard.HeaderIcon>
						<FontIcon Glyph="&#xE9A6;"/>
					</local:SettingsCard.HeaderIcon>
					<ComboBox Style="{StaticResource ProfileComboBoxStyle}"
						DropDownOpened="ComboBox_DropDownOpened"
						ItemsSource="{x:Bind ViewModel.CaptureMethods, Mode=OneTime}"
						SelectedIndex="{x:Bind ViewModel.CaptureMethod, Mode=TwoWay}"/>
				</local:SettingsCard>
				<muxc:InfoBar x:Uid="Profile_General_DesktopDuplicationWarning"
					IsClosable="False"
					IsOpen="{x:Bind ViewModel.IsCaptureMethodDesktopDuplication, Mode=OneWay}"
					Severity="Warning"/>
				<local:SettingsCard Style="{StaticResource ProfileCardStyle}"
					Loaded="ProfileCard_Loaded"
					SizeChanged="ProfileCard_SizeChanged"
					x:Name="AutoScaleSettingsCard"
					x:Uid="Profile_General_AutoScale"
					x:Load="{x:Bind ViewModel.IsNotDefaultProfile, Mode=OneTime}"
					IsWrapEnabled="True">
					<local:SettingsCard.HeaderIcon>
						<FontIcon Glyph="&#xE945;"/>
					</local:SettingsCard.HeaderIcon>
					<ComboBox Style="{StaticResource ProfileComboBoxStyle}" DropDownOpened="ComboBox_DropDownOpened" SelectedIndex="{x:Bind ViewModel.AutoScale, Mode=TwoWay}">
						<ComboBoxItem x:Uid="Profile_General_AutoScale_Disabled"/>
						<ComboBoxItem x:Uid="Profile_General_AutoScale_Fullscreen"/>
						<ComboBoxItem x:Uid="Profile_General_AutoScale_Windowed"/>
					</ComboBox>
				</local:SettingsCard>
				<local:SettingsCard Style="{StaticResource ProfileCardStyle}" Loaded="ProfileCard_Loaded" SizeChanged="ProfileCard_SizeChanged" x:Uid="Profile_General_3DGameMode">
					<local:SettingsCard.HeaderIcon>
						<FontIcon Glyph="&#xE7FC;"/>
					</local:SettingsCard.HeaderIcon>
					<ToggleSwitch x:Uid="ToggleSwitch" IsOn="{x:Bind ViewModel.Is3DGameMode, Mode=TwoWay}"/>
				</local:SettingsCard>
				<!-- HDR compatibility is temporarily unavailable while explicit conversion effects are designed. -->
				<local:SettingsCard Style="{StaticResource ProfileCardStyle}"
					Loaded="ProfileCard_Loaded"
					SizeChanged="ProfileCard_SizeChanged"
					x:Name="MultimonitorSettingsCard"
					x:Uid="Profile_General_Multimonitor"
					x:Load="{x:Bind ViewModel.HasMultipleMonitors, Mode=OneTime}"
					IsWrapEnabled="True">
					<local:SettingsCard.HeaderIcon>
						<FontIcon Glyph="&#xF5A9;"/>
					</local:SettingsCard.HeaderIcon>
					<ComboBox Style="{StaticResource ProfileComboBoxStyle}"
						DropDownOpened="ComboBox_DropDownOpened"
						ItemsSource="{x:Bind ViewModel.MonitorOptions, Mode=OneTime}"
						SelectedIndex="{x:Bind ViewModel.MonitorSelection, Mode=TwoWay}"/>
				</local:SettingsCard>
			</local:SettingsGroup>
			<local:SettingsGroup x:Uid="Profile_WindowedScaling">
				<local:SettingsCard Style="{StaticResource ProfileCardStyle}"
					Loaded="ProfileCard_Loaded"
					SizeChanged="ProfileCard_SizeChanged"
					x:Uid="Profile_WindowedScaling_InitialScaleFactor"
					IsWrapEnabled="True">
					<local:SettingsCard.HeaderIcon>
						<FontIcon Glyph="&#xE740;"/>
					</local:SettingsCard.HeaderIcon>
					<Grid Loaded="PairEditor_Loaded" SizeChanged="PairEditor_SizeChanged">
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto"/>
							<RowDefinition Height="Auto"/>
						</Grid.RowDefinitions>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*"/>
							<ColumnDefinition Width="0"/>
							<ColumnDefinition Width="Auto"/>
						</Grid.ColumnDefinitions>
						<ComboBox Style="{StaticResource ProfileComboBoxStyle}"
							x:Name="InitialWindowedScaleFactorComboBox"
							Grid.Column="0"
							HorizontalAlignment="Stretch"
							VerticalAlignment="Stretch"
							DropDownOpened="ComboBox_DropDownOpened"
							SelectedIndex="{x:Bind ViewModel.InitialWindowedScaleFactor, Mode=TwoWay}"
							SelectionChanged="InitialWindowedScaleFactorComboBox_SelectionChanged">
							<ComboBoxItem x:Uid="Profile_WindowedScaling_InitialScaleFactor_Auto"/>
							<x:String>1x</x:String>
							<x:String>1.25x</x:String>
							<x:String>1.5x</x:String>
							<x:String>1.75x</x:String>
							<x:String>2x</x:String>
							<x:String>3x</x:String>
							<ComboBoxItem x:Uid="Profile_WindowedScaling_InitialScaleFactor_Custom"/>
						</ComboBox>
						<Grid Grid.Column="2"
							x:Name="CustomInitialWindowedScaleFactorEditor"
							Visibility="Collapsed"
							ColumnSpacing="{StaticResource ProfileControlGap}">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*"/>
								<ColumnDefinition Width="{StaticResource ProfileUnitColumnWidth}"/>
							</Grid.ColumnDefinitions>
							<muxc:NumberBox Style="{StaticResource ProfileNumberBoxStyle}"
								x:Name="CustomInitialWindowedScaleFactorNumberBox"
								x:Uid="Profile_InitialScale_Input"
								Loaded="NumberBox_Loaded"
								Maximum="10"
								Minimum="1"
								NumberFormatter="{x:Bind local:App.DoubleFormatter, Mode=OneTime}"
								SmallChange="0.1"
								Value="{x:Bind ViewModel.CustomInitialWindowedScaleFactor, Mode=TwoWay}"/>
							<TextBlock Grid.Column="1" Text="x" VerticalAlignment="Center" IsHitTestVisible="False" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
						</Grid>
					</Grid>
				</local:SettingsCard>
			</local:SettingsGroup>
			<local:SettingsGroup x:Uid="Profile_Performance">
				<local:SettingsCard Style="{StaticResource ProfileCardStyle}"
					Loaded="ProfileCard_Loaded"
					SizeChanged="ProfileCard_SizeChanged"
					x:Name="GraphicsCardSettingsCard"
					x:Uid="Profile_General_GraphicsCard"
					IsWrapEnabled="True">
					<local:SettingsCard.HeaderIcon>
						<FontIcon Glyph="&#xF211;"/>
					</local:SettingsCard.HeaderIcon>
					<ComboBox Style="{StaticResource ProfileComboBoxStyle}"
						x:Uid="Profile_General_GraphicsCard_Input"
						DropDownOpened="ComboBox_DropDownOpened"
						IsEnabled="{x:Bind ViewModel.IsGraphicsCardSelectionEnabled, Mode=OneWay}"
						ItemsSource="{x:Bind ViewModel.GraphicsCards, Mode=OneWay}"
						SelectedItem="{x:Bind ViewModel.GraphicsCard, Mode=TwoWay}"/>
				</local:SettingsCard>
				<muxc:InfoBar x:Uid="Profile_General_NoGraphicsCard" IsClosable="False" IsOpen="{x:Bind ViewModel.IsNoGraphicsCard, Mode=OneWay}" Severity="Warning"/>
				<muxc:InfoBar x:Uid="Profile_General_GraphicsCardUnavailable"
					IsClosable="False"
					IsOpen="{x:Bind ViewModel.ShowGraphicsCardUnavailableWarning, Mode=OneWay}"
					Severity="Warning"/>
			</local:SettingsGroup>
			<StackPanel x:Name="FrameRefreshGroup" Spacing="8">
				<Grid Margin="1,0,0,0" ColumnSpacing="16" SizeChanged="FrameRefreshHeader_SizeChanged">
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="Auto"/>
					</Grid.RowDefinitions>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*"/>
						<ColumnDefinition Width="Auto"/>
					</Grid.ColumnDefinitions>
					<TextBlock x:Uid="FrameRefresh_Title"
						Style="{ThemeResource BodyStrongTextBlockStyle}"
						VerticalAlignment="Center"
						TextWrapping="Wrap"
						AutomationProperties.HeadingLevel="Level2"/>
					<local:WrapPanel x:Name="FrameRefreshHeaderActions" Grid.Column="1" HorizontalAlignment="Right" HorizontalSpacing="8" VerticalSpacing="8" VerticalAlignment="Center">
						<!-- The stock ListBox template does not bind CornerRadius. -->
						<Border x:Name="FrameRefreshModeBorder"
							CornerRadius="6" Padding="1" BorderThickness="1"
							Background="{ThemeResource ControlAltFillColorSecondaryBrush}"
							BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}">
							<ListBox x:Uid="FrameRefresh_Mode_Input"
								ItemContainerStyle="{StaticResource FrameRefreshModeItemStyle}"
								Background="Transparent"
								BorderThickness="0"
								SelectionMode="Single"
								SelectedIndex="{x:Bind ViewModel.FrameRefreshModeIndex, Mode=TwoWay}"
								Padding="0"
								ScrollViewer.HorizontalScrollMode="Disabled"
								ScrollViewer.HorizontalScrollBarVisibility="Disabled"
								ScrollViewer.VerticalScrollMode="Disabled"
								ScrollViewer.VerticalScrollBarVisibility="Disabled">
								<ListBox.ItemsPanel>
									<ItemsPanelTemplate>
										<StackPanel Orientation="Horizontal"/>
									</ItemsPanelTemplate>
								</ListBox.ItemsPanel>
								<ListBoxItem x:Uid="FrameRefresh_Mode_Simple"/>
								<ListBoxItem x:Uid="FrameRefresh_Mode_Advanced"/>
							</ListBox>
						</Border>
						<Button x:Uid="FrameRefresh_ResetButton" VerticalAlignment="Center" Click="{x:Bind ViewModel.ResetFrameRefresh}"/>
					</local:WrapPanel>
				</Grid>
				<local:SettingsExpander Style="{StaticResource ProfileExpanderStyle}"
					Loaded="ProfileExpander_Loaded"
					SizeChanged="ProfileExpander_SizeChanged"
					x:Uid="FrameRefresh_RateGroup"
					IsExpanded="True"
					IsWrapEnabled="True">
					<local:SettingsExpander.HeaderIcon>
						<FontIcon Glyph="&#xE9D9;"/>
					</local:SettingsExpander.HeaderIcon>
					<local:SettingsExpander.Items>
						<local:SettingsCard Style="{StaticResource ProfileItemStyle}"
							Loaded="ProfileCard_Loaded"
							SizeChanged="ProfileCard_SizeChanged"
							x:Uid="FrameRefresh_Content"
							IsWrapEnabled="True">
							<Grid Loaded="PairEditor_Loaded" SizeChanged="PairEditor_SizeChanged">
								<Grid.RowDefinitions>
									<RowDefinition Height="Auto"/>
									<RowDefinition Height="Auto"/>
								</Grid.RowDefinitions>
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="*"/>
									<ColumnDefinition Width="0"/>
									<ColumnDefinition Width="Auto"/>
								</Grid.ColumnDefinitions>
								<ComboBox x:Uid="FrameRefresh_Content_Input"
									Style="{StaticResource ProfileComboBoxStyle}"
									DropDownOpened="ComboBox_DropDownOpened"
									SelectedIndex="{x:Bind ViewModel.ContentFrameRateModeIndex, Mode=TwoWay}">
									<ComboBoxItem x:Uid="FrameRefresh_Source" ContentTemplate="{StaticResource RtssOptionTextTemplate}"/>
									<ComboBoxItem x:Uid="FrameRefresh_Custom" ContentTemplate="{StaticResource RtssOptionTextTemplate}"/>
								</ComboBox>
								<Grid Grid.Column="2"
									Visibility="{x:Bind ViewModel.ShowContentFrameRate, Mode=OneWay}"
									ColumnSpacing="{StaticResource ProfileControlGap}">
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="*"/>
										<ColumnDefinition Width="{StaticResource ProfileUnitColumnWidth}"/>
									</Grid.ColumnDefinitions>
									<muxc:NumberBox x:Uid="FrameRefresh_ContentRate_Input"
										Style="{StaticResource ProfileNumberBoxStyle}"
										Minimum="15"
										Maximum="360"
										SmallChange="1"
										LargeChange="10"
										Loaded="NumberBox_Loaded"
										NumberFormatter="{x:Bind local:App.IntegerFormatter, Mode=OneTime}"
										Value="{x:Bind ViewModel.ContentFrameRate, Mode=TwoWay}"/>
									<TextBlock Grid.Column="1" Text="FPS" VerticalAlignment="Center" IsHitTestVisible="False" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
								</Grid>
							</Grid>
						</local:SettingsCard>
						<local:SettingsCard Style="{StaticResource ProfileItemStyle}"
							Loaded="ProfileCard_Loaded"
							SizeChanged="ProfileCard_SizeChanged"
							x:Uid="FrameRefresh_Pacing"
							IsWrapEnabled="True"
							Visibility="{x:Bind ViewModel.ShowContentPacing, Mode=OneWay}">
							<ComboBox x:Uid="FrameRefresh_Pacing_Input"
								Style="{StaticResource ProfileComboBoxStyle}"
								DropDownOpened="ComboBox_DropDownOpened"
								IsEnabled="{x:Bind ViewModel.IsContentPacingEnabled, Mode=OneWay}"
								SelectedIndex="{x:Bind ViewModel.FrameSyncModeIndex, Mode=TwoWay}">
								<ComboBoxItem x:Uid="FrameSync_Mode_FrontEdge"/>
								<ComboBoxItem x:Uid="FrameSync_Mode_Async"/>
								<ComboBoxItem x:Uid="FrameSync_Mode_Reflex"/>
							</ComboBox>
						</local:SettingsCard>
					</local:SettingsExpander.Items>
				</local:SettingsExpander>
				<local:SettingsExpander Style="{StaticResource ProfileExpanderStyle}"
					Loaded="ProfileExpander_Loaded"
					SizeChanged="ProfileExpander_SizeChanged"
					x:Uid="Rtss_Takeover"
					IsExpanded="True"
					IsWrapEnabled="True">
					<local:SettingsExpander.HeaderIcon>
						<FontIcon Glyph="&#xE71B;"/>
					</local:SettingsExpander.HeaderIcon>
					<local:SettingsExpander.Items>
						<local:SettingsCard Style="{StaticResource ProfileItemStyle}"
							Loaded="ProfileCard_Loaded"
							SizeChanged="ProfileCard_SizeChanged"
							x:Uid="Rtss_SimpleSync"
							IsWrapEnabled="True"
							Visibility="{x:Bind ViewModel.IsSimpleFrameRefresh, Mode=OneWay}">
							<ToggleSwitch x:Uid="Rtss_SimpleSync_Input" Style="{StaticResource RightAlignedCompactToggleSwitchStyle}" IsOn="{x:Bind ViewModel.SimpleRtssSync, Mode=TwoWay}"/>
						</local:SettingsCard>
						<local:SettingsCard Style="{StaticResource ProfileItemStyle}"
							Loaded="ProfileCard_Loaded"
							SizeChanged="ProfileCard_SizeChanged"
							x:Uid="Rtss_TargetLimit"
							IsWrapEnabled="True"
							Visibility="{x:Bind ViewModel.IsAdvancedFrameRefresh, Mode=OneWay}">
							<Grid Loaded="PairEditor_Loaded" SizeChanged="PairEditor_SizeChanged">
								<Grid.RowDefinitions>
									<RowDefinition Height="Auto"/>
									<RowDefinition Height="Auto"/>
								</Grid.RowDefinitions>
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="*"/>
									<ColumnDefinition Width="0"/>
									<ColumnDefinition Width="Auto"/>
								</Grid.ColumnDefinitions>
								<ComboBox x:Uid="Rtss_Mode_Input"
									Style="{StaticResource ProfileComboBoxStyle}"
									DropDownOpened="ComboBox_DropDownOpened"
									SelectedIndex="{x:Bind ViewModel.RtssModeIndex, Mode=TwoWay}">
									<ComboBoxItem x:Uid="Rtss_Scope_None" ContentTemplate="{StaticResource RtssOptionTextTemplate}"/>
									<ComboBoxItem x:Uid="Rtss_Rate_Sync" ContentTemplate="{StaticResource RtssOptionTextTemplate}"/>
									<ComboBoxItem x:Uid="Rtss_Rate_Custom" ContentTemplate="{StaticResource RtssOptionTextTemplate}"/>
								</ComboBox>
								<Grid Grid.Column="2"
									Visibility="{x:Bind ViewModel.ShowRtssCustomRate, Mode=OneWay}"
									ColumnSpacing="{StaticResource ProfileControlGap}">
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="*"/>
										<ColumnDefinition Width="{StaticResource ProfileUnitColumnWidth}"/>
									</Grid.ColumnDefinitions>
									<muxc:NumberBox x:Uid="Rtss_CustomRate_Input"
										Style="{StaticResource ProfileNumberBoxStyle}"
										Minimum="15"
										Maximum="360"
										SmallChange="1"
										LargeChange="10"
										Loaded="NumberBox_Loaded"
										NumberFormatter="{x:Bind local:App.IntegerFormatter, Mode=OneTime}"
										Value="{x:Bind ViewModel.RtssCustomRate, Mode=TwoWay}"/>
									<TextBlock Grid.Column="1" Text="FPS" VerticalAlignment="Center" IsHitTestVisible="False" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
								</Grid>
							</Grid>
						</local:SettingsCard>
						<local:SettingsCard Style="{StaticResource ProfileItemStyle}"
							Loaded="ProfileCard_Loaded"
							SizeChanged="ProfileCard_SizeChanged"
							IsWrapEnabled="True"
							Visibility="{x:Bind ViewModel.ShowRtssOptions, Mode=OneWay}">
							<local:SettingsCard.Header>
								<TextBlock x:Uid="Rtss_ScopeLabel" TextWrapping="Wrap"/>
							</local:SettingsCard.Header>
							<ComboBox x:Name="RtssScopeField"
								x:Uid="Rtss_Scope_Input"
								Style="{StaticResource ProfileComboBoxStyle}"
								DropDownOpened="ComboBox_DropDownOpened"
								SelectedIndex="{x:Bind ViewModel.RtssTargetScopeIndex, Mode=TwoWay}">
								<ComboBoxItem x:Uid="Rtss_Scope_Global" ContentTemplate="{StaticResource RtssOptionTextTemplate}"/>
								<ComboBoxItem x:Uid="Rtss_Scope_Target" ContentTemplate="{StaticResource RtssOptionTextTemplate}"/>
							</ComboBox>
						</local:SettingsCard>
						<local:SettingsCard Style="{StaticResource ProfileItemStyle}"
							Loaded="ProfileCard_Loaded"
							SizeChanged="ProfileCard_SizeChanged"
							IsWrapEnabled="True"
							Visibility="{x:Bind ViewModel.ShowRtssOptions, Mode=OneWay}">
							<local:SettingsCard.Header>
								<TextBlock x:Uid="Rtss_ExitLabel" TextWrapping="Wrap"/>
							</local:SettingsCard.Header>
							<ComboBox x:Name="RtssExitField"
								x:Uid="Rtss_ExitPolicy_Input"
								Style="{StaticResource ProfileComboBoxStyle}"
								DropDownOpened="ComboBox_DropDownOpened"
								SelectedIndex="{x:Bind ViewModel.RtssExitPolicyIndex, Mode=TwoWay}">
								<ComboBoxItem x:Uid="Rtss_Exit_Keep" ContentTemplate="{StaticResource RtssOptionTextTemplate}"/>
								<ComboBoxItem x:Uid="Rtss_Exit_Restore" ContentTemplate="{StaticResource RtssOptionTextTemplate}"/>
							</ComboBox>
						</local:SettingsCard>
						<local:SettingsCard Style="{StaticResource ProfileItemStyle}"
							Loaded="ProfileCard_Loaded"
							SizeChanged="ProfileCard_SizeChanged"
							x:Name="RtssStatusCard"
							Padding="16,8,48,8"
							Description="{x:Bind ViewModel.RtssStatusDescription, Mode=OneWay}"
							AutomationProperties.LiveSetting="Polite"
							IsWrapEnabled="True">
							<local:SettingsCard.HeaderIcon>
								<FontIcon Width="20" Height="20" Glyph="{x:Bind ViewModel.RtssStatusGlyph, Mode=OneWay}"/>
