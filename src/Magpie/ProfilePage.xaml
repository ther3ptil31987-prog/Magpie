						<FontIcon Glyph="&#xE756;"/>
					</local:SettingsCard.HeaderIcon>
					<TextBox MinWidth="0" HorizontalAlignment="Stretch" KeyDown="LaunchParametersTextBox_KeyDown" Text="{x:Bind ViewModel.LaunchParameters, Mode=TwoWay}">
						<TextBox.ContextFlyout>
							<local:TextMenuFlyout/>
						</TextBox.ContextFlyout>
					</TextBox>
				</local:SettingsCard>
				<local:SettingsCard Style="{StaticResource ProfileCardStyle}" Loaded="ProfileCard_Loaded" SizeChanged="ProfileCard_SizeChanged" x:Uid="Profile_Advanced_DestAlignment">
					<local:SettingsCard.HeaderIcon>
						<FontIcon Glyph="&#xE799;"/>
					</local:SettingsCard.HeaderIcon>
					<ComboBox Style="{StaticResource ProfileComboBoxStyle}" DropDownOpened="ComboBox_DropDownOpened" SelectedIndex="{x:Bind ViewModel.DestAlignment, Mode=TwoWay}">
						<ComboBoxItem x:Uid="Profile_Advanced_DestAlignment_TopLeft"/>
						<ComboBoxItem x:Uid="Profile_Advanced_DestAlignment_TopCenter"/>
						<ComboBoxItem x:Uid="Profile_Advanced_DestAlignment_TopRight"/>
						<ComboBoxItem x:Uid="Profile_Advanced_DestAlignment_Left"/>
						<ComboBoxItem x:Uid="Profile_Advanced_DestAlignment_Center"/>
						<ComboBoxItem x:Uid="Profile_Advanced_DestAlignment_Right"/>
						<ComboBoxItem x:Uid="Profile_Advanced_DestAlignment_BottomLeft"/>
						<ComboBoxItem x:Uid="Profile_Advanced_DestAlignment_BottomCenter"/>
						<ComboBoxItem x:Uid="Profile_Advanced_DestAlignment_BottomRight"/>
					</ComboBox>
				</local:SettingsCard>
				<local:SettingsCard Style="{StaticResource ProfileCardStyle}" Loaded="ProfileCard_Loaded" SizeChanged="ProfileCard_SizeChanged" x:Uid="Profile_Advanced_DisableDirectFlip">
					<local:SettingsCard.HeaderIcon>
						<FontIcon Glyph="&#xF259;"/>
					</local:SettingsCard.HeaderIcon>
					<ToggleSwitch x:Uid="ToggleSwitch" IsOn="{x:Bind ViewModel.IsDirectFlipDisabled, Mode=TwoWay}"/>
				</local:SettingsCard>
				<local:SettingsCard Style="{StaticResource ProfileCardStyle}"
					Loaded="ProfileCard_Loaded"
					SizeChanged="ProfileCard_SizeChanged"
					x:Uid="Profile_Advanced_ParameterFocusSwitching"
					IsWrapEnabled="True">
					<local:SettingsCard.HeaderIcon>
						<FontIcon Glyph="&#xE9E9;"/>
					</local:SettingsCard.HeaderIcon>
					<ToggleSwitch x:Uid="ToggleSwitch" IsOn="{x:Bind ViewModel.IsParameterFocusSwitchingEnabled, Mode=TwoWay}"/>
				</local:SettingsCard>
			</local:SettingsGroup>
		</local:SimpleStackPanel>
	</local:PageFrame>
</Page>
